    <!-- Quick actions -->
    <string name="ai_qa_explain_word">Объяснить слово</string>
    <string name="ai_qa_explain_word_prompt">Объясни слово «%1$s» (%2$s): значение, чтение/произношение, нюансы, стиль, частые сочетания и 3 примера с переводом.</string>
    <string name="ai_qa_grammar">Объяснить грамматику</string>
    <string name="ai_qa_grammar_prompt">Объясни простыми словами грамматику (%2$s): структура, типичные ошибки и примеры. Тема: %1$s</string>
    <string name="ai_qa_compare">Сравнить похожие слова</string>
    <string name="ai_qa_compare_prompt">Чем отличаются эти слова (%2$s): %1$s? Объясни нюансы и дай контрастные примеры.</string>
    <string name="ai_qa_mistakes">Разобрать мои ошибки</string>
    <string name="ai_qa_mistakes_prompt">Посмотри на мои слабые слова и слова, которые я путаю (%2$s). Разбери мои типичные ошибки и дай советы и ассоциации для каждого.</string>
    <string name="ai_qa_why_errors">Почему я ошибаюсь?</string>
    <string name="ai_qa_why_errors_prompt">По моей статистике (%2$s): почему я повторяю одни и те же ошибки? Найди закономерности и предложи конкретный план.</string>
    <string name="ai_qa_idiom">Объяснить идиому</string>
    <string name="ai_qa_idiom_prompt">Объясни идиому / устойчивое выражение «%1$s» (%2$s): буквальный и реальный смысл, происхождение, когда употреблять, примеры.</string>
    <string name="ai_qa_examples">Примеры употребления</string>
    <string name="ai_qa_examples_prompt">Дай 6 естественных примеров (%2$s) со словом «%1$s» разного уровня сложности, каждый с переводом.</string>
    <string name="ai_qa_thematic">Тематический словарь</string>
    <string name="ai_qa_thematic_prompt">Составь список из 15 полезных слов (%2$s) по теме «%1$s», по одному на строку в формате `слово — перевод` (с чтением, где нужно).</string>
    <string name="ai_qa_review_today">Что повторить сегодня?</string>
    <string name="ai_qa_review_today_prompt">По моей статистике (%2$s): что мне стоит повторить сегодня и как? Составь короткий план на 15 минут.</string>
    <string name="ai_qa_dialogue">Практика диалога</string>
    <string name="ai_qa_dialogue_prompt">Давай потренируем диалог (%2$s). Ситуация: %1$s. Начинай ты и исправляй мои ошибки по ходу.</string>

