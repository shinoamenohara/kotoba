    <!-- Quick actions -->
    <string name="ai_qa_explain_word">Explain a word</string>
    <string name="ai_qa_explain_word_prompt">Explain the %2$s word “%1$s”: meaning, reading/pronunciation, nuances, register, common collocations and 3 examples with translations.</string>
    <string name="ai_qa_grammar">Explain grammar</string>
    <string name="ai_qa_grammar_prompt">Explain this %2$s grammar point simply, with the structure, typical mistakes and examples: %1$s</string>
    <string name="ai_qa_compare">Compare similar words</string>
    <string name="ai_qa_compare_prompt">What is the difference between these %2$s words: %1$s? Explain the nuances and give contrasting examples.</string>
    <string name="ai_qa_mistakes">Analyze my mistakes</string>
    <string name="ai_qa_mistakes_prompt">Look at my weak words and the words I confuse in %2$s. Analyse my typical mistakes and give me tips and memory hooks for each.</string>
    <string name="ai_qa_why_errors">Why do I keep making errors?</string>
    <string name="ai_qa_why_errors_prompt">Based on my statistics in %2$s, why do I keep making the same errors? Find the patterns and suggest a concrete plan to fix them.</string>
    <string name="ai_qa_idiom">Explain an idiom</string>
    <string name="ai_qa_idiom_prompt">Explain the %2$s idiom / set expression “%1$s”: literal and real meaning, origin if interesting, when to use it, and examples.</string>
    <string name="ai_qa_examples">Generate examples</string>
    <string name="ai_qa_examples_prompt">Give me 6 natural example sentences in %2$s with “%1$s” at different levels, each with a translation.</string>
    <string name="ai_qa_thematic">Thematic vocabulary</string>
    <string name="ai_qa_thematic_prompt">Make a list of 15 useful %2$s words for the topic “%1$s”, one per line as `term — translation` (include the reading where relevant).</string>
    <string name="ai_qa_review_today">What to review today?</string>
    <string name="ai_qa_review_today_prompt">Based on my statistics in %2$s, what should I review today and how? Make a short plan for a 15-minute session.</string>
    <string name="ai_qa_dialogue">Dialogue practice</string>
    <string name="ai_qa_dialogue_prompt">Let\'s practise a dialogue in %2$s. Scenario: %1$s. You start; correct my mistakes as we go.</string>

