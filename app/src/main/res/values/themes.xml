<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kotoba" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/kotoba_background</item>
    </style>

    <style name="Theme.Kotoba.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kotoba_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Kotoba</item>
    </style>

    <color name="kotoba_primary">#4F46E5</color>
    <color name="kotoba_background">#FBF8FF</color>
    <color name="ic_launcher_background">#4F46E5</color>
</resources>
